{
  "info": {
    "name": "Carry & Co. API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run on a seeded development database. Set sandboxConfigured=true only with Maya Sandbox credentials. The checkout demo group creates a sandbox session and tries to cancel it after checking idempotency. Reset the local database before a fresh complete run."
  },
