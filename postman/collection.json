        {
          "name": "Create a sandbox checkout",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('checkoutKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.response.to.have.status(Number(pm.environment.get('sandboxConfigured') === 'true' ? 201 : 503)));",
                  "if (pm.response.code !== 204) { const envelope = pm.response.json(); pm.test('Consistent envelope', () => pm.expect(envelope.success).to.equal(pm.response.code < 400)); }",
                  "if (pm.response.code === 201) { const order = pm.response.json().data; pm.environment.set('orderId', order.id); pm.test('Server total and pending status', () => { pm.expect(order.total_cents).to.be.above(1); pm.expect(order.status).to.equal('pending_payment'); }); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{checkoutKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shipping\": {\n    \"name\": \"Jamie Cruz\",\n    \"phone\": \"09171234567\",\n    \"address\": \"123 Quezon Avenue\",\n    \"city\": \"Iligan City\",\n    \"postalCode\": \"9200\"\n  },\n  \"couponCode\": \"CARRY10\",\n  \"total_cents\": 1\n}",
