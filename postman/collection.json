    {
      "name": "System",
      "item": [
        {
          "name": "API health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));",
                  "if (pm.response.code !== 204) { const envelope = pm.response.json(); pm.test('Consistent envelope', () => pm.expect(envelope.success).to.equal(pm.response.code < 400)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
