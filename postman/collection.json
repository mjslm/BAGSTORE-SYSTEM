        {
          "name": "Replay the same checkout key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.response.to.have.status(Number(pm.environment.get('sandboxConfigured') === 'true' ? 200 : 503)));",
                  "if (pm.response.code !== 204) { const envelope = pm.response.json(); pm.test('Consistent envelope', () => pm.expect(envelope.success).to.equal(pm.response.code < 400)); }",
                  "if (pm.response.code === 200) pm.test('Same order reference returned', () => pm.expect(pm.response.json().data.id).to.equal(pm.environment.get('orderId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{checkoutKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
